# Copie para .env.local e preencha com os dados do seu projeto Firebase
# (Console Firebase > Configurações do projeto > Seus apps > App da Web).
# Sem preencher, o app usa o projeto "demo-navalha" no emulador local.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_SENDER_ID=

# Login Google no Android/iOS (Console Google Cloud > Credenciais > IDs do cliente OAuth)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# URL do Worker da Cloudflare (fotos e lembretes)
EXPO_PUBLIC_WORKER_URL=http://127.0.0.1:8787

# 1 = usar emuladores locais do Firebase mesmo com projeto real configurado
EXPO_PUBLIC_USE_EMULATORS=0
