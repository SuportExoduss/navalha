  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "expo": "~58.0.14",
    "expo-auth-session": "~58.0.13",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-location": "~58.0.17",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.23",
    "expo-status-bar": "~58.0.3",
    "expo-web-browser": "~58.0.6",
    "firebase": "^13.0.0",
    "geofire-common": "^6.0.0",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "firebase-tools": "^15.34.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts src/services/*.test.ts",
    "emulators": "firebase emulators:start --only auth,firestore",
    "export:web": "expo export --platform web",
    "test:regras": "firebase emulators:exec --only firestore \"tsx --test tests/regras.test.ts\"",
    "worker:dev": "cd worker && npx wrangler dev"
  },
  "private": true
}
