rules_version = '2';

// Regras de segurança do Navalha.
// - Cliente só vê os próprios agendamentos; barbeiro só edita o próprio cardápio.
// - Pagamentos, avaliações reveladas e assinatura são gravados só pelo Worker
//   (conta de serviço, que ignora estas regras).
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function eu() { return request.auth.uid; }
    function barbearia(bid) { return get(/databases/$(database)/documents/barbearias/$(bid)).data; }
    function ehDono(bid) { return logado() && barbearia(bid).donoUid == eu(); }
    function ehBarbeiro(bid) {
      return logado() && exists(/databases/$(database)/documents/barbearias/$(bid)/barbeiros/$(eu()));
    }
    function ehDaCasa(bid) { return ehDono(bid) || ehBarbeiro(bid); }
    function mudou(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(campos); }
    // Fotos só do nosso Worker (R2) ou a foto da conta Google: nada de imagem externa ou pixel de rastreio (SEC-009).
    // O endereço local é o do emulador nos testes; em produção ele simplesmente não carrega.
    function urlFotoOk(u) {
      return u is string && u.size() <= 400 && (u.matches('https://navalha-worker[.]navalha-worker[.]workers[.]dev/fotos/.*')
        || u.matches('https://lh[0-9][.]googleusercontent[.]com/.*') || u.matches('http://(127[.]0[.]0[.]1|10[.]0[.]2[.]2):8787/fotos/.*'));
    }
    function fotoOk(d, campo) { return !(campo in d) || urlFotoOk(d[campo]); }

    // ---------- Usuários ----------
    match /users/{uid} {
      allow read: if logado() && eu() == uid;
      allow create: if logado() && eu() == uid
        && request.resource.data.uid == uid
        && !request.resource.data.keys().hasAny(['notaCliente', 'avaliouBarbearias']) && fotoOk(request.resource.data, 'fotoUrl') && fotoOk(request.resource.data, 'bannerUrl');
      // A nota como cliente é calculada pelo servidor.
      // As avaliações que a pessoa deu (avaliouBarbearias) só o Worker grava, junto com a nota da casa.
      allow update: if logado() && eu() == uid && !mudou(['uid', 'notaCliente', 'avaliouBarbearias', 'criadoEm'])
        // Marca da última reserva: só o horário do servidor (serverTimestamp), nunca uma data escolhida pelo app.
        && (!mudou(['ultimaReserva']) || request.resource.data.ultimaReserva == request.time)
        && fotoOk(request.resource.data, 'fotoUrl') && fotoOk(request.resource.data, 'bannerUrl');
      allow delete: if logado() && eu() == uid;
    }

    // ---------- Barbearias ----------
    match /barbearias/{bid} {
      function fotosDaCasaOk(d) { return fotoOk(d, 'capaUrl') && fotoOk(d, 'logoUrl') && (!('fotos' in d) || d.fotos.size() <= 12); }
      // Comissão é dado comercial: não vai no perfil público do barbeiro (leitura aberta). Fica para um doc privado (SEC-008).
      function perfilBarbeiroOk(d) { return fotoOk(d, 'fotoUrl') && fotoOk(d, 'bannerUrl') && !('comissaoPercent' in d); }
      function casa() { return /databases/$(database)/documents/barbearias/$(bid); }
      function barb(u) { return /databases/$(database)/documents/barbearias/$(bid)/barbeiros/$(u); }
      // 1 se o barbeiro u conta como ativo antes/depois desta gravação.
      function ativoAntes(u) { return exists(barb(u)) && get(barb(u)).data.ativo == true ? 1 : 0; }
      function ativoDepois(u) { return existsAfter(barb(u)) && getAfter(barb(u)).data.ativo == true ? 1 : 0; }
      // Contador de barbeiros ativos (limite do plano): só muda junto com o barbeiro indicado em
      // mudouBarbeiro, na mesma gravação, e nunca passa do limite quando sobe.
      function contadorOk(antes, depois) {
        let u = depois.get('mudouBarbeiro', '');
        let delta = u == '' ? 0 : ativoDepois(u) - ativoAntes(u);
        return depois.barbeirosAtivos == antes.get('barbeirosAtivos', 0) + delta
          && (delta <= 0 || depois.barbeirosAtivos <= depois.assinatura.limiteBarbeiros);
      }
      // 60 dias grátis, uma vez por conta: a marca em testes/{uid} nasce junto e não pode ser apagada.
      function testeOk(d) {
        let marca = /databases/$(database)/documents/testes/$(eu());
        return d.assinatura.keys().hasOnly(['status', 'venceEm', 'limiteBarbeiros'])
          && d.assinatura.status == 'teste' && d.assinatura.limiteBarbeiros == 10 && d.emDia == true
          && d.assinatura.venceEm is int
          && d.assinatura.venceEm >= request.time.toMillis() + 59 * 86400000
          && d.assinatura.venceEm <= request.time.toMillis() + 60 * 86400000 + 600000
          && !exists(marca) && existsAfter(marca);
      }
      // Sem teste: rascunho fora da busca, até o Worker confirmar um plano pago.
      function rascunhoOk(d) {
        return d.assinatura.keys().hasOnly(['status', 'limiteBarbeiros'])
          && d.assinatura.status == 'rascunho' && d.assinatura.limiteBarbeiros == 1 && d.emDia == false;
      }
      // Nota da casa (média, quantidade, soma e ranking) só o Worker grava: ninguém cria a casa já com nota nem mexe na própria.
      function notasZeradas(d) {
        return d.resumo.get('notaApp', 0) == 0 && d.resumo.get('totalAvaliacoesApp', 0) == 0
          && !d.resumo.keys().hasAny(['somaEstrelasApp', 'notaRanking']);
      }
      function notasIntactas(antes, depois) {
        return depois.resumo.get('notaApp', 0) == antes.resumo.get('notaApp', 0)
          && depois.resumo.get('totalAvaliacoesApp', 0) == antes.resumo.get('totalAvaliacoesApp', 0)
          && depois.resumo.get('somaEstrelasApp', null) == antes.resumo.get('somaEstrelasApp', null)
          && depois.resumo.get('notaRanking', null) == antes.resumo.get('notaRanking', null);
      }
      // Na busca só aparece casa publicada E em dia (teste ou mensalidade); a equipe sempre vê a sua.
      allow read: if (resource.data.publicada == true && resource.data.get('emDia', false) == true) || ehDaCasa(bid);
      allow create: if logado()
        && request.resource.data.donoUid == eu() && fotosDaCasaOk(request.resource.data) && notasZeradas(request.resource.data)
        && request.resource.data.barbeirosAtivos == 1 && request.resource.data.mudouBarbeiro == eu()
        && (testeOk(request.resource.data) || rascunhoOk(request.resource.data));
      // O dono edita tudo, menos assinatura e "em dia" (só o Worker, depois de conferir no Google Play),
      // as notas (só o Worker, a partir de avaliações conferidas) e o contador (que só anda junto com a equipe).
      allow update: if fotosDaCasaOk(request.resource.data) && ((ehDono(bid) && !mudou(['donoUid', 'assinatura', 'emDia', 'criadoEm'])
        && notasIntactas(resource.data, request.resource.data)
        && (!mudou(['barbeirosAtivos', 'mudouBarbeiro']) || contadorOk(resource.data, request.resource.data)))
        // O barbeiro, ao salvar o próprio cardápio, só atualiza a parte do resumo que vem do cardápio.
        || (ehBarbeiro(bid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resumo'])
          && request.resource.data.resumo.diff(resource.data.resumo).affectedKeys().hasOnly(['fotosDestaque', 'precoMin', 'precoMax', 'categorias']))
        // Quem aceita o convite soma a si mesmo no contador (barrado se a equipe já está cheia no plano).
        || (logado() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['barbeirosAtivos', 'mudouBarbeiro'])
          && request.resource.data.mudouBarbeiro == eu() && contadorOk(resource.data, request.resource.data)));
      // Excluir a barbearia: só o dono (Configurações › Excluir barbearia).
      allow delete: if ehDono(bid);

      match /barbeiros/{uid} {
        allow read: if true;
        // Dono cadastra (inclusive a si mesmo, no mesmo lote que cria a casa);
        // barbeiro entra aceitando um convite válido desta casa.
        // Todo barbeiro que entra ativo, liga ou desliga, ou sai, move o contador da casa na mesma gravação.
        function contadorDaCasa(antes, depois) {
          return getAfter(casa()).data.get('mudouBarbeiro', '') == uid
            && getAfter(casa()).data.barbeirosAtivos == (exists(casa()) ? get(casa()).data.get('barbeirosAtivos', 0) : 0) + depois - antes;
        }
        allow create: if logado() && perfilBarbeiroOk(request.resource.data)
          && request.resource.data.get('nota', {'media': 0, 'total': 0}) == {'media': 0, 'total': 0}
          && contadorDaCasa(0, request.resource.data.ativo == true ? 1 : 0) && (
          ehDono(bid)
          || getAfter(/databases/$(database)/documents/barbearias/$(bid)).data.donoUid == eu()
          || (eu() == uid
              && getAfter(/databases/$(database)/documents/convites/$(request.resource.data.conviteCodigo)).data.usadoPor == uid
              && getAfter(/databases/$(database)/documents/convites/$(request.resource.data.conviteCodigo)).data.barbeariaId == bid)
        );
        allow update: if perfilBarbeiroOk(request.resource.data)
          && !mudou(['nota']) // nota do barbeiro: só o Worker, a partir das avaliações
          && (ehDono(bid) || (logado() && eu() == uid && !mudou(['ativo', 'barbeariaId', 'conviteCodigo'])))
          && (!mudou(['ativo']) || contadorDaCasa(resource.data.ativo == true ? 1 : 0, request.resource.data.ativo == true ? 1 : 0));
        allow delete: if ehDono(bid) && contadorDaCasa(resource.data.ativo == true ? 1 : 0, 0);
      }

      match /servicos/{sid} {
        allow read: if true;
        allow create, update: if (!('fotos' in request.resource.data) || request.resource.data.fotos.size() <= 6)
          && (ehDono(bid) || (ehBarbeiro(bid) && request.resource.data.barbeiroId == eu()));
        allow delete: if ehDono(bid) || (ehBarbeiro(bid) && resource.data.barbeiroId == eu());
      }

      // Folgas e pausas pontuais: o barbeiro cuida das próprias; o dono, de todas.
      // Qualquer cliente lê (os horários livres descontam as folgas), então aqui não vai o motivo.
      match /bloqueios/{id} {
        allow read: if logado();
        allow create, update: if (ehDono(bid) || (ehBarbeiro(bid) && request.resource.data.barbeiroId == eu()))
          && request.resource.data.fim > request.resource.data.inicio
          && !('motivo' in request.resource.data);
        allow delete: if ehDono(bid) || (ehBarbeiro(bid) && resource.data.barbeiroId == eu());
      }
      // Motivo da folga (ex.: "médico"), mesmo id do bloqueio: só o dono e o próprio barbeiro leem.
      match /motivosFolga/{id} {
        allow read: if ehDono(bid) || (ehBarbeiro(bid) && resource.data.barbeiroId == eu());
        // Folga sem motivo não tem este doc, e remover a folga apaga os dois no mesmo lote.
        allow delete: if ehDono(bid) || (ehBarbeiro(bid) && (resource == null || resource.data.barbeiroId == eu()));
        allow create, update: if (ehDono(bid) || (ehBarbeiro(bid) && request.resource.data.barbeiroId == eu()))
          && request.resource.data.keys().hasOnly(['barbeiroId', 'motivo'])
          && request.resource.data.motivo is string && request.resource.data.motivo.size() <= 100;
      }
      // Dado do barbeiro que não pode ir no documento público dele: o telefone (o barbeiro grava).
      // Leem o dono e o próprio barbeiro.
      match /equipePrivado/{uid} {
        allow read: if ehDono(bid) || (ehBarbeiro(bid) && eu() == uid);
        allow create: if ehBarbeiro(bid) && eu() == uid && request.resource.data.keys().hasOnly(['telefone'])
          && request.resource.data.telefone is string && request.resource.data.telefone.size() <= 15;
        allow update: if ehBarbeiro(bid) && eu() == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['telefone'])
          && request.resource.data.telefone is string && request.resource.data.telefone.size() <= 15;
        allow delete: if ehDono(bid);
      }
    }

    // ---------- Assinatura ----------
    // Marca de "já usou os 60 dias grátis": só nasce (junto com a primeira casa), nunca muda nem some.
    match /testes/{uid} {
      allow get: if logado() && eu() == uid;
      allow create: if logado() && eu() == uid && request.resource.data.keys().hasOnly(['em']) && request.resource.data.em == request.time;
      allow update, delete: if false;
    }
    // Dados da compra no Google Play (token): só o Worker grava; o dono lê.
    match /assinaturas/{bid} {
      allow read: if ehDono(bid);
      allow write: if false;
    }

    // ---------- Notificações da casa (marcado, cancelado, resumo do mês) ----------
    // O Worker grava depois de conferir o agendamento; o destinatário só lê e marca como lida.
    match /notificacoes/{id} {
      allow read: if logado() && resource.data.paraUid == eu();
      allow update: if logado() && resource.data.paraUid == eu()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida'])
        && request.resource.data.lida == true;
      allow create, delete: if false;
    }

    // ---------- Convites (código curto, coleção raiz para o barbeiro achar a casa) ----------
    match /convites/{codigo} {
      allow get: if logado();
      allow list: if false;
      allow create: if ehDono(request.resource.data.barbeariaId)
        && request.resource.data.criadoPor == eu()
        && request.resource.data.codigo == codigo;
      // Aceite: só preenche usadoPor, uma única vez, antes de expirar.
      allow update: if logado()
        && resource.data.get('usadoPor', null) == null
        && request.resource.data.usadoPor == eu()
        && request.time.toMillis() < resource.data.expiraEm
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usadoPor']);
      allow delete: if ehDono(resource.data.barbeariaId);
    }

    // ---------- Agendamentos ----------
    match /agendamentos/{aid} {
      function ag() { return resource.data; }
      // Preço, duração e barbeiro vêm do cardápio, não do que o app manda (SEC-003).
      function bateComCardapio(n) {
        let s = get(/databases/$(database)/documents/barbearias/$(n.barbeariaId)/servicos/$(n.servicoId)).data;
        return s.barbeiroId == n.barbeiroId && s.precoCentavos == n.precoCentavos && s.duracaoMin == n.duracaoMin
          && s.get('ativo', true) != false;
      }
      // Bloco é do barbeiro quando o prefixo da chave é literalmente o id dele. Nada de regex com
      // dado do usuário: barbeiroId ".*" casaria com a agenda de qualquer um (SEC-001).
      function blocoDoBarbeiro(chave, barbeiroId) { return chave.split('_')[0] == barbeiroId; }
      // Chave do bloco que começa em `ms`, no mesmo formato de chavesOcupacao (barbeiro_AAAA-MM-DD_HHMM, Brasília).
      function dois(n) { return (n < 10 ? '0' : '') + string(n); }
      function chaveDoBloco(barbeiroId, ms) {
        let t = timestamp.value(ms - 10800000);
        return barbeiroId + '_' + string(t.year()) + '-' + dois(t.month()) + '-' + dois(t.day()) + '_' + dois(t.hours()) + dois(t.minutes());
      }
      // Os blocos são os do horário reservado (SEC-017): início no passo da casa, primeiro bloco = início,
      // último = o que cobre o fim, e quantidade certa. Sem isto, slots de outro horário passavam por cima
      // de quem já tinha marcado. ponytail: os blocos do meio não são lidos (limite de leituras das regras);
      // quem pular um deles só abre buraco na própria reserva. Fechar de vez = reservar pelo Worker.
      function blocosDoHorario(n) {
        let passo = barbearia(n.barbeariaId).passoMin * 60000;
        let total = n.slots.size();
        return n.inicio is int && n.inicio % passo == 0
          && n.fim == n.inicio + n.duracaoMin * 60000
          && (total - 1) * passo < n.duracaoMin * 60000 && total * passo >= n.duracaoMin * 60000
          && n.slots[0] == chaveDoBloco(n.barbeiroId, n.inicio)
          && n.slots[total - 1] == chaveDoBloco(n.barbeiroId, n.inicio + (total - 1) * passo);
      }
      // Motivo do cancelamento: só junto com o cancelar, assinado por quem cancela (ninguém se passa pelo outro lado).
      function cancelamentoOk(por) {
        let c = request.resource.data.get('cancelamento', null);
        return !mudou(['cancelamento']) || (c != null && request.resource.data.status == 'cancelado'
          && c.keys().hasOnly(['por', 'motivo', 'em']) && c.por == por
          && c.motivo is string && c.motivo.size() >= 1 && c.motivo.size() <= 200 && c.em is int);
      }
      // Limite de uso (SEC-006): a reserva pelo app grava a marca da última reserva na mesma transação, e entre
      // duas reservas da mesma conta precisa haver 20 s. Gente de verdade não sente; robô de reservas falsas trava.
      function intervaloEntreReservasOk() {
        let perfil = /databases/$(database)/documents/users/$(eu());
        let antes = exists(perfil) ? get(perfil).data.get('ultimaReserva', null) : null;
        return getAfter(perfil).data.get('ultimaReserva', null) == request.time
          && (antes == null || request.time > antes + duration.value(20, 's'));
      }
      // Barbeiro vê só os próprios horários; o dono, a casa toda (clientes e faturamento dos colegas são do dono).
      function daCasaParaEste(a) { return ehDono(a.barbeariaId) || (ehBarbeiro(a.barbeariaId) && a.barbeiroId == eu()); }
      allow read: if logado() && (ag().clienteUid == eu() || ag().barbeiroId == eu() || ehDono(ag().barbeariaId));

      allow create: if logado()
        && request.resource.data.id == aid
        && request.resource.data.slots.size() >= 1 && request.resource.data.slots.size() <= 24
        && request.resource.data.inicio > request.time.toMillis() - 3600000
        && (
          (request.resource.data.origem == 'app' && request.resource.data.clienteUid == eu()
             && request.resource.data.status == 'reservado' && intervaloEntreReservasOk())
          || (request.resource.data.origem == 'balcao' && daCasaParaEste(request.resource.data)
             && request.resource.data.clienteUid == null && request.resource.data.status == 'confirmado')
        )
        // O barbeiro é da casa (e não foi desligado), e os blocos travados são dele (ninguém trava a agenda com chaves falsas).
        && get(/databases/$(database)/documents/barbearias/$(request.resource.data.barbeariaId)/barbeiros/$(request.resource.data.barbeiroId)).data.get('ativo', true) != false
        && blocoDoBarbeiro(request.resource.data.slots[0], request.resource.data.barbeiroId)
        && blocoDoBarbeiro(request.resource.data.slots[request.resource.data.slots.size() - 1], request.resource.data.barbeiroId)
        && bateComCardapio(request.resource.data)
        && blocosDoHorario(request.resource.data)
        // A trava: os blocos de ocupação precisam nascer junto, na mesma transação.
        && getAfter(/databases/$(database)/documents/ocupacao/$(request.resource.data.slots[0])).data.agendamentoId == aid
        && getAfter(/databases/$(database)/documents/ocupacao/$(request.resource.data.slots[request.resource.data.slots.size() - 1])).data.agendamentoId == aid;

      // Cliente só cancela; a casa confirma, conclui, marca falta e anexa fotos.
      // Status anterior conta (SEC-004): o cliente só cancela o que ainda está de pé e não começou
      // (falta e atendimento concluído não se apagam), e reserva cancelada não volta a valer,
      // porque os blocos dela já foram liberados para outra pessoa.
      // As marcas de avaliação são do Worker: ninguém bloqueia (nem libera) uma avaliação pelo app.
      allow update: if logado() && !mudou(['id', 'barbeariaId', 'barbeiroId', 'clienteUid', 'inicio', 'fim', 'slots', 'precoCentavos', 'pagamentoId', 'avaliacao', 'avaliacoes', 'pedidoAvaliacao'])
        && (
          (ag().clienteUid == eu() && request.resource.data.status == 'cancelado'
             && ag().status in ['reservado', 'confirmado'] && ag().inicio > request.time.toMillis()
             && request.resource.data.diff(ag()).affectedKeys().hasOnly(['status', 'atualizadoEm', 'fotosAprovadas', 'cancelamento'])
             && cancelamentoOk('cliente'))
          || (ag().clienteUid == eu() && request.resource.data.diff(ag()).affectedKeys().hasOnly(['fotosAprovadas', 'atualizadoEm']))
          // Exclusão de conta (LGPD): o cliente apaga o próprio nome e o telefone do histórico da barbearia.
          || (ag().clienteUid == eu() && request.resource.data.clienteNome == 'Cliente removido'
             && !('clienteTelefone' in request.resource.data)
             && request.resource.data.diff(ag()).affectedKeys().hasOnly(['clienteNome', 'clienteTelefone', 'atualizadoEm']))
          || (daCasaParaEste(ag()) && ag().status != 'cancelado'
             && request.resource.data.status in ['confirmado', 'concluido', 'faltou', 'cancelado']
             && cancelamentoOk('casa'))
        );
      allow delete: if false;
    }

    // Um documento por bloco de horário. ID fixo = barbeiro_data_HHMM.
    match /ocupacao/{chave} {
      allow read: if logado();
      allow create: if logado()
        && chave.split('_')[0] == request.resource.data.barbeiroId
        && getAfter(/databases/$(database)/documents/agendamentos/$(request.resource.data.agendamentoId)).data.slots.hasAny([chave])
        && getAfter(/databases/$(database)/documents/agendamentos/$(request.resource.data.agendamentoId)).data.barbeiroId == request.resource.data.barbeiroId;
      allow update: if false;
      allow delete: if logado()
        && getAfter(/databases/$(database)/documents/agendamentos/$(resource.data.agendamentoId)).data.status == 'cancelado';
    }

    // ---------- Fases 3 a 5: escritos pelo servidor ----------
    match /pagamentos/{id} {
      allow read: if logado() && (resource.data.clienteUid == eu() || ehDono(resource.data.barbeariaId));
      allow write: if false;
    }
    // Só existe a avaliação da barbearia, e ela é pública (aba Avaliações da casa). As antigas entre cliente e
    // barbeiro (até 23/out) ninguém lê mais.
    match /avaliacoes/{id} {
      // Privadas (decisão do dono, 25/out): o app mostra só a média em estrelas da casa (resumo.notaApp).
      // Só o Worker lê e grava (POST /avaliacoes): confere o corte concluído e quem avalia.
      allow read, write: if false;
    }
    match /clubes/{id} {
      allow read: if true;
      // Dono só mexe no clube da própria casa: o update confere o documento atual e não deixa trocar de casa (SEC-005).
      allow create: if logado() && ehDono(request.resource.data.barbeariaId);
      allow update: if logado() && ehDono(resource.data.barbeariaId) && !mudou(['barbeariaId']);
      allow delete: if logado() && ehDono(resource.data.barbeariaId);
    }
    match /assinaturasClube/{id} {
      allow read: if logado() && resource.data.clienteUid == eu();
      allow write: if false;
    }

    // Monitoramento de erros: o app só grava, com campos e tamanhos fixos; o dono lê no console.
    match /erros/{id} {
      allow create: if logado() && request.resource.data.uid == eu()
        && request.resource.data.keys().hasOnly(['uid', 'onde', 'mensagem', 'pilha', 'plataforma', 'versao', 'em'])
        && request.resource.data.mensagem is string && request.resource.data.mensagem.size() <= 500
        && request.resource.data.pilha is string && request.resource.data.pilha.size() <= 2000
        && request.resource.data.onde is string && request.resource.data.onde.size() <= 100;
      allow read, update, delete: if false;
    }

    // Métricas do piloto: o app só grava.
    match /eventos/{id} {
      // Só os campos e tipos conhecidos: ninguém usa a coleção de métricas para gravar lixo (SEC-006).
      allow create: if logado() && request.resource.data.uid == eu()
        && request.resource.data.keys().hasOnly(['tipo', 'uid', 'barbeariaId', 'duracaoMs', 'em'])
        && request.resource.data.tipo in ['abriu_app', 'viu_barbearia', 'iniciou_agendamento', 'agendou', 'cancelou', 'faltou', 'concluiu'];
      allow read, update, delete: if false;
    }
  }
}
