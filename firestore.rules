rules_version = '2';

// Regras de segurança do Navalha.
// - Cliente só vê os próprios agendamentos; barbeiro só edita o próprio cardápio.
// - Pagamentos, avaliações reveladas e assinatura são gravados só pelo Worker
//   (conta de serviço, que ignora estas regras).
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function eu() { return request.auth.uid; }
    function barbearia(bid) { return get(/databases/$(database)/documents/barbearias/$(bid)).data; }
    function ehDono(bid) { return logado() && barbearia(bid).donoUid == eu(); }
    function ehBarbeiro(bid) {
      return logado() && exists(/databases/$(database)/documents/barbearias/$(bid)/barbeiros/$(eu()));
    }
    function ehDaCasa(bid) { return ehDono(bid) || ehBarbeiro(bid); }
    function mudou(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(campos); }
    // Fotos só do nosso Worker (R2) ou a foto da conta Google: nada de imagem externa ou pixel de rastreio (SEC-009).
    // O endereço local é o do emulador nos testes; em produção ele simplesmente não carrega.
    function urlFotoOk(u) {
      return u is string && u.size() <= 400 && (u.matches('https://navalha-worker[.]navalha-worker[.]workers[.]dev/fotos/.*')
        || u.matches('https://lh[0-9][.]googleusercontent[.]com/.*') || u.matches('http://(127[.]0[.]0[.]1|10[.]0[.]2[.]2):8787/fotos/.*'));
    }
    function fotoOk(d, campo) { return !(campo in d) || urlFotoOk(d[campo]); }

    // ---------- Usuários ----------
    match /users/{uid} {
      allow read: if logado() && eu() == uid;
      allow create: if logado() && eu() == uid
        && request.resource.data.uid == uid
        && !('notaCliente' in request.resource.data) && fotoOk(request.resource.data, 'fotoUrl');
      // A nota como cliente é calculada pelo servidor.
      allow update: if logado() && eu() == uid && !mudou(['uid', 'notaCliente', 'criadoEm'])
        // Marca da última reserva: só o horário do servidor (serverTimestamp), nunca uma data escolhida pelo app.
        && (!mudou(['ultimaReserva']) || request.resource.data.ultimaReserva == request.time)
        && fotoOk(request.resource.data, 'fotoUrl');
      allow delete: if logado() && eu() == uid;
    }

    // ---------- Barbearias ----------
    match /barbearias/{bid} {
      function fotosDaCasaOk(d) { return fotoOk(d, 'capaUrl') && fotoOk(d, 'logoUrl') && (!('fotos' in d) || d.fotos.size() <= 12); }
      // Comissão é dado comercial: não vai no perfil público do barbeiro (leitura aberta). Fica para um doc privado (SEC-008).
      function perfilBarbeiroOk(d) { return fotoOk(d, 'fotoUrl') && !('comissaoPercent' in d); }
      allow read: if resource.data.publicada == true || ehDaCasa(bid);
      allow create: if logado()
        && request.resource.data.donoUid == eu()
        && request.resource.data.assinatura.status in ['rascunho', 'teste'] && fotosDaCasaOk(request.resource.data);
      // O dono edita tudo, menos a assinatura (controlada pelo pagamento) e as notas Google.
      allow update: if fotosDaCasaOk(request.resource.data) && ((ehDono(bid) && !mudou(['donoUid', 'assinatura', 'criadoEm'])
        && request.resource.data.resumo.get('notaGoogle', null) == resource.data.resumo.get('notaGoogle', null))
        // O barbeiro, ao salvar o próprio cardápio, só atualiza a parte do resumo que vem do cardápio.
        || (ehBarbeiro(bid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resumo'])
          && request.resource.data.resumo.diff(resource.data.resumo).affectedKeys().hasOnly(['fotosDestaque', 'precoMin', 'precoMax', 'categorias'])));
      allow delete: if false;

      match /barbeiros/{uid} {
        allow read: if true;
        // Dono cadastra (inclusive a si mesmo, no mesmo lote que cria a casa);
        // barbeiro entra aceitando um convite válido desta casa.
        allow create: if logado() && perfilBarbeiroOk(request.resource.data) && (
          ehDono(bid)
          || getAfter(/databases/$(database)/documents/barbearias/$(bid)).data.donoUid == eu()
          || (eu() == uid
              && getAfter(/databases/$(database)/documents/convites/$(request.resource.data.conviteCodigo)).data.usadoPor == uid
              && getAfter(/databases/$(database)/documents/convites/$(request.resource.data.conviteCodigo)).data.barbeariaId == bid)
        );
        allow update: if perfilBarbeiroOk(request.resource.data)
          && (ehDono(bid) || (logado() && eu() == uid && !mudou(['ativo', 'nota', 'barbeariaId', 'conviteCodigo'])));
        allow delete: if ehDono(bid);
      }

      match /servicos/{sid} {
        allow read: if true;
        allow create, update: if (!('fotos' in request.resource.data) || request.resource.data.fotos.size() <= 6)
          && (ehDono(bid) || (ehBarbeiro(bid) && request.resource.data.barbeiroId == eu()));
        allow delete: if ehDono(bid) || (ehBarbeiro(bid) && resource.data.barbeiroId == eu());
      }

      // Folgas e pausas pontuais: o barbeiro cuida das próprias; o dono, de todas.
      match /bloqueios/{id} {
        allow read: if logado();
        allow create, update: if (ehDono(bid) || (ehBarbeiro(bid) && request.resource.data.barbeiroId == eu()))
          && request.resource.data.fim > request.resource.data.inicio;
        allow delete: if ehDono(bid) || (ehBarbeiro(bid) && resource.data.barbeiroId == eu());
      }
    }

    // ---------- Convites (código curto, coleção raiz para o barbeiro achar a casa) ----------
    match /convites/{codigo} {
      allow get: if logado();
      allow list: if false;
      allow create: if ehDono(request.resource.data.barbeariaId)
        && request.resource.data.criadoPor == eu()
        && request.resource.data.codigo == codigo;
      // Aceite: só preenche usadoPor, uma única vez, antes de expirar.
      allow update: if logado()
        && resource.data.get('usadoPor', null) == null
        && request.resource.data.usadoPor == eu()
        && request.time.toMillis() < resource.data.expiraEm
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usadoPor']);
      allow delete: if ehDono(resource.data.barbeariaId);
    }

    // ---------- Agendamentos ----------
    match /agendamentos/{aid} {
      function ag() { return resource.data; }
      // Preço, duração e barbeiro vêm do cardápio, não do que o app manda (SEC-003).
      function bateComCardapio(n) {
        let s = get(/databases/$(database)/documents/barbearias/$(n.barbeariaId)/servicos/$(n.servicoId)).data;
        return s.barbeiroId == n.barbeiroId && s.precoCentavos == n.precoCentavos && s.duracaoMin == n.duracaoMin;
      }
      // Bloco é do barbeiro quando o prefixo da chave é literalmente o id dele. Nada de regex com
      // dado do usuário: barbeiroId ".*" casaria com a agenda de qualquer um (SEC-001).
      function blocoDoBarbeiro(chave, barbeiroId) { return chave.split('_')[0] == barbeiroId; }
      // Motivo do cancelamento: só junto com o cancelar, assinado por quem cancela (ninguém se passa pelo outro lado).
      function cancelamentoOk(por) {
        let c = request.resource.data.get('cancelamento', null);
        return !mudou(['cancelamento']) || (c != null && request.resource.data.status == 'cancelado'
          && c.keys().hasOnly(['por', 'motivo', 'em']) && c.por == por
          && c.motivo is string && c.motivo.size() >= 1 && c.motivo.size() <= 200 && c.em is int);
      }
      // Limite de uso (SEC-006): a reserva pelo app grava a marca da última reserva na mesma transação, e entre
      // duas reservas da mesma conta precisa haver 20 s. Gente de verdade não sente; robô de reservas falsas trava.
      function intervaloEntreReservasOk() {
        let perfil = /databases/$(database)/documents/users/$(eu());
        let antes = exists(perfil) ? get(perfil).data.get('ultimaReserva', null) : null;
        return getAfter(perfil).data.get('ultimaReserva', null) == request.time
          && (antes == null || request.time > antes + duration.value(20, 's'));
      }
      allow read: if logado() && (ag().clienteUid == eu() || ehDaCasa(ag().barbeariaId));

      allow create: if logado()
        && request.resource.data.id == aid
        && request.resource.data.slots.size() >= 1 && request.resource.data.slots.size() <= 24
        && request.resource.data.inicio > request.time.toMillis() - 3600000
        && (
          (request.resource.data.origem == 'app' && request.resource.data.clienteUid == eu()
             && request.resource.data.status == 'reservado' && intervaloEntreReservasOk())
          || (request.resource.data.origem == 'balcao' && ehDaCasa(request.resource.data.barbeariaId)
             && request.resource.data.clienteUid == null && request.resource.data.status == 'confirmado')
        )
        // O barbeiro é da casa, e os blocos travados são dele (ninguém trava a agenda com chaves falsas).
        && exists(/databases/$(database)/documents/barbearias/$(request.resource.data.barbeariaId)/barbeiros/$(request.resource.data.barbeiroId))
        && blocoDoBarbeiro(request.resource.data.slots[0], request.resource.data.barbeiroId)
        && blocoDoBarbeiro(request.resource.data.slots[request.resource.data.slots.size() - 1], request.resource.data.barbeiroId)
        && bateComCardapio(request.resource.data)
        // A trava: os blocos de ocupação precisam nascer junto, na mesma transação.
        && getAfter(/databases/$(database)/documents/ocupacao/$(request.resource.data.slots[0])).data.agendamentoId == aid
        && getAfter(/databases/$(database)/documents/ocupacao/$(request.resource.data.slots[request.resource.data.slots.size() - 1])).data.agendamentoId == aid;

      // Cliente só cancela; a casa confirma, conclui, marca falta e anexa fotos.
      // Status anterior conta (SEC-004): o cliente só cancela o que ainda está de pé e não começou
      // (falta e atendimento concluído não se apagam), e reserva cancelada não volta a valer,
      // porque os blocos dela já foram liberados para outra pessoa.
      allow update: if logado() && !mudou(['id', 'barbeariaId', 'barbeiroId', 'clienteUid', 'inicio', 'fim', 'slots', 'precoCentavos', 'pagamentoId'])
        && (
          (ag().clienteUid == eu() && request.resource.data.status == 'cancelado'
             && ag().status in ['reservado', 'confirmado'] && ag().inicio > request.time.toMillis()
             && request.resource.data.diff(ag()).affectedKeys().hasOnly(['status', 'atualizadoEm', 'fotosAprovadas', 'cancelamento'])
             && cancelamentoOk('cliente'))
          || (ag().clienteUid == eu() && request.resource.data.diff(ag()).affectedKeys().hasOnly(['fotosAprovadas', 'atualizadoEm']))
          // Exclusão de conta (LGPD): o cliente apaga o próprio nome do histórico da barbearia.
          || (ag().clienteUid == eu() && request.resource.data.clienteNome == 'Cliente removido'
             && request.resource.data.diff(ag()).affectedKeys().hasOnly(['clienteNome', 'atualizadoEm']))
          || (ehDaCasa(ag().barbeariaId) && ag().status != 'cancelado'
             && request.resource.data.status in ['confirmado', 'concluido', 'faltou', 'cancelado']
             && cancelamentoOk('casa'))
        );
      allow delete: if false;
    }

    // Um documento por bloco de horário. ID fixo = barbeiro_data_HHMM.
    match /ocupacao/{chave} {
      allow read: if logado();
      allow create: if logado()
        && chave.split('_')[0] == request.resource.data.barbeiroId
        && getAfter(/databases/$(database)/documents/agendamentos/$(request.resource.data.agendamentoId)).data.slots.hasAny([chave])
        && getAfter(/databases/$(database)/documents/agendamentos/$(request.resource.data.agendamentoId)).data.barbeiroId == request.resource.data.barbeiroId;
      allow update: if false;
      allow delete: if logado()
        && getAfter(/databases/$(database)/documents/agendamentos/$(resource.data.agendamentoId)).data.status == 'cancelado';
    }

    // ---------- Fases 3 a 5: escritos pelo servidor ----------
    match /pagamentos/{id} {
      allow read: if logado() && (resource.data.clienteUid == eu() || ehDono(resource.data.barbeariaId));
      allow write: if false;
    }
    match /avaliacoes/{id} {
      allow read: if resource.data.visivel == true
        && resource.data.direcao == 'cliente_para_barbeiro';
      // A avaliação é criada oculta; o Worker revela quando os dois lados avaliam (dupla-cega).
      allow create: if logado() && request.resource.data.visivel == false
        && request.resource.data.estrelas in [1, 2, 3, 4, 5]
        && (
          (request.resource.data.direcao == 'cliente_para_barbeiro' && request.resource.data.clienteUid == eu())
          || (request.resource.data.direcao == 'barbeiro_para_cliente' && request.resource.data.barbeiroId == eu())
        );
      allow update, delete: if false;
    }
    match /clubes/{id} {
      allow read: if true;
      // Dono só mexe no clube da própria casa: o update confere o documento atual e não deixa trocar de casa (SEC-005).
      allow create: if logado() && ehDono(request.resource.data.barbeariaId);
      allow update: if logado() && ehDono(resource.data.barbeariaId) && !mudou(['barbeariaId']);
      allow delete: if logado() && ehDono(resource.data.barbeariaId);
    }
    match /assinaturasClube/{id} {
      allow read: if logado() && resource.data.clienteUid == eu();
      allow write: if false;
    }

    // Monitoramento de erros: o app só grava, com campos e tamanhos fixos; o dono lê no console.
    match /erros/{id} {
      allow create: if logado() && request.resource.data.uid == eu()
        && request.resource.data.keys().hasOnly(['uid', 'onde', 'mensagem', 'pilha', 'plataforma', 'versao', 'em'])
        && request.resource.data.mensagem is string && request.resource.data.mensagem.size() <= 500
        && request.resource.data.pilha is string && request.resource.data.pilha.size() <= 2000
        && request.resource.data.onde is string && request.resource.data.onde.size() <= 100;
      allow read, update, delete: if false;
    }

    // Métricas do piloto: o app só grava.
    match /eventos/{id} {
      // Só os campos e tipos conhecidos: ninguém usa a coleção de métricas para gravar lixo (SEC-006).
      allow create: if logado() && request.resource.data.uid == eu()
        && request.resource.data.keys().hasOnly(['tipo', 'uid', 'barbeariaId', 'duracaoMs', 'em'])
        && request.resource.data.tipo in ['abriu_app', 'viu_barbearia', 'iniciou_agendamento', 'agendou', 'cancelou', 'faltou', 'concluiu'];
      allow read, update, delete: if false;
    }
  }
}
