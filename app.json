{
  "expo": {
    "name": "Navalha",
    "slug": "navalha",
    "scheme": "navalha",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0E0F11",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.trevotec.navalha",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos sua localização para mostrar as barbearias mais perto de você.",
        "NSCameraUsageDescription": "Usamos a câmera para fotografar os cortes realizados.",
        "NSPhotoLibraryUsageDescription": "Usamos a galeria para escolher fotos de perfil e de cortes."
      }
    },
    "android": {
      "package": "com.trevotec.navalha",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Navalha",
      "shortName": "Navalha",
      "themeColor": "#0E0F11",
      "backgroundColor": "#0E0F11"
    },
    "plugins": [
      "./plugins/local-properties",
      "./plugins/modo-imersivo",
      "./plugins/android-studio",
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos sua localização para mostrar as barbearias mais perto de você."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Usamos a câmera para fotografar os cortes realizados.",
          "photosPermission": "Usamos a galeria para escolher fotos de perfil e de cortes."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "lembretes",
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#C8A24A"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.SUBSTITUA_PELO_IOS_CLIENT_ID"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E0F11"
        }
      ],
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
